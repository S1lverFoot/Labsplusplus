#include <windows.h>
#include "module1.rh"

IDD_DIALOG1 DIALOGEX 0, 0, 200, 90
STYLE DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
Caption "Enter Text"
FONT 9, "Segoe UI"
BEGIN
	EDITTEXT        IDC_EDIT1, 10, 30, 180, 20, ES_AUTOHSCROLL
	DEFPUSHBUTTON   "OK", IDOK, 50, 60, 40, 14
	PUSHBUTTON      "Cancel", IDCANCEL, 110, 60, 40, 14
END